# Discord
DISCORD_TOKEN=your_discord_bot_token_here
MONITOR_CHANNEL_ID=your_discord_channel_id_to_monitor

# API Configuration
API_PORT=3000
GUILD_ID=your_discord_guild_id_here

# Optional: Set to production for production environment
NODE_ENV=development

# Calendar Sync
# Public ICS URL of the iCal feed
CALENDAR_ICS_URL=
# How frequently to sync, in minutes
CALENDAR_SYNC_INTERVAL_MINUTES=10

# Notifications
# Comma-separated "alias:channelId" routes. A "default" alias is used as fallback.
# The /notify endpoint is disabled when this is empty.
NOTIFY_ROUTES=portal-alerts:000000000000000000,default:000000000000000000

# Printing
# Base URL of the print control API on the lounge print host.
PRINT_AGENT_URL=
# Optional bearer token matching the print agent's tokenFile.
PRINT_AGENT_TOKEN=
PRINT_ALLOWED_ROLE_IDS=
PRINT_ALLOWED_CHANNEL_IDS=
PRINT_COOLDOWN_SECONDS=5
PRINT_MAX_FILE_MB=10

# Lounge officer status button (ESP32)
# Channel that receives a single status embed, edited in place as updates arrive.
OFFICER_STATUS_CHANNEL_ID=
# Shared secret the ESP32 sends as "Authorization: Bearer <key>".
# Leave empty to allow unauthenticated posts.
OFFICER_STATUS_API_KEY=
# Mark a device offline when no update arrives within this many seconds.
OFFICER_STATUS_STALE_SECONDS=90

# 3D Printing (Bambu Lab X2D)
# Base URL of the Bambu control API on the lounge print host.
BAMBU_AGENT_URL=
# Optional bearer token matching the Bambu agent's tokenFile.
BAMBU_AGENT_TOKEN=
BAMBU_ALLOWED_ROLE_IDS=
BAMBU_ALLOWED_CHANNEL_IDS=
BAMBU_COOLDOWN_SECONDS=10
BAMBU_MAX_FILE_MB=25
# Channel that receives a snapshot + embed when a print finishes or fails.
BAMBU_NOTIFY_CHANNEL_ID=
BAMBU_NOTIFY_POLL_SECONDS=20
