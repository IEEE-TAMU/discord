# Discord
DISCORD_TOKEN=your_discord_bot_token_here
MONITOR_CHANNEL_ID=your_discord_channel_id_to_monitor

# API Configuration
API_PORT=3000
GUILD_ID=your_discord_guild_id_here

# Optional: Set to production for production environment
NODE_ENV=development

# Calendar Sync
# Public ICS URL of the iCal feed
CALENDAR_ICS_URL=
# How frequently to sync, in minutes
CALENDAR_SYNC_INTERVAL_MINUTES=10

# Notifications
# Comma-separated "alias:channelId" routes. A "default" alias is used as fallback.
# The /notify endpoint is disabled when this is empty.
NOTIFY_ROUTES=portal-alerts:000000000000000000,default:000000000000000000
