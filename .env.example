# Discord Bot Token (required)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# API Configuration
API_PORT=3000
LISTEN_ADDR=0.0.0.0

# Guild Configuration (required for member/event management)
GUILD_ID=your_discord_guild_id_here

# Calendar Sync
# Public ICS URL of the iCal feed
CALENDAR_ICS_URL=
# How frequently to sync, in minutes (default: 10)
CALENDAR_SYNC_INTERVAL_MINUTES=10
